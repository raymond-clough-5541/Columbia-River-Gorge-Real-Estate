#!/usr/bin/env bash
# commit-msg — the STAGE-2 gate: message-token checks (approval, scope,
# battery, worklog, portability) against the REAL commit message.
#
# git invokes commit-msg with the message file as $1 — the only stage
# where the message reliably exists. (git 2.47 `commit -m` writes
# COMMIT_EDITMSG only AFTER pre-commit succeeds, so message checks at
# pre-commit time were reading a stale message — incident M26, caught
# R73 by CHECK 9's freshness requirement.)
#
# To bypass (emergency only — leaves a reflog record):
#   git commit --no-verify

set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
exec bash "$ROOT/scripts/enforce-methodology.sh" commit-msg "$1"
