#!/usr/bin/env bash
# pre-commit-methodology — runs the Track 0 enforcement gate.
#
# Called by the pre-commit wrapper (scripts/git-hooks/pre-commit).
# Blocks commits that violate the methodology rules:
#   - No approval token → blocked
#   - No design-pass before component changes → blocked
#   - Changed files outside approved scope → blocked
#   - No battery log for code changes → blocked
#   - No worklog reference → blocked
#
# See docs/MASTER-FIX-PLAN.md Track 0 for the full design.
# Bypass (emergency): git commit --no-verify

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
bash "$SCRIPT_DIR/../enforce-methodology.sh"
