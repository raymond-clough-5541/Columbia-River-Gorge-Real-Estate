{
  "name": "free-trader-signin",
  "description": "The portability PROOF: scripts/e2e/01-signin-signup.mts (Free Trader, hard-coded) re-expressed as a portable scenario. Same app, same human flow — zero engine changes. Sign in as Jordan via the welcome page, verify the feed loads.",
  "base": "http://localhost:3000",
  "viewport": "390x844",
  "steps": [
    { "action": "clear" },
    {
      "action": "nav",
      "url": "/?surface=welcome",
      "expectText": "Sign In",
      "shot": "01-welcome-fresh"
    },
    {
      "action": "click",
      "role": "tab",
      "name": "Sign In",
      "shot": "02-signin-tab"
    },
    {
      "action": "fill",
      "label": "Email",
      "text": "jordan@example.com"
    },
    {
      "action": "fill",
      "label": "Password",
      "text": "testpass123",
      "shot": "03-signin-filled"
    },
    {
      "action": "click",
      "role": "button",
      "name": "Sign In",
      "critical": true
    },
    {
      "action": "wait",
      "text": "Free Trader",
      "timeout": 10000
    },
    {
      "action": "shot",
      "label": "04-after-signin",
      "expectText": "Free Trader"
    }
  ]
}
