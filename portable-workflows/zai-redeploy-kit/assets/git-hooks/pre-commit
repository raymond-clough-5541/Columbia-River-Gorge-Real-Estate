#!/usr/bin/env bash
# pre-commit — runs all pre-commit-* hook scripts in scripts/git-hooks/.
#
# Conventions:
# - Each hook in scripts/git-hooks/pre-commit-* is run in turn.
# - If any hook exits non-zero, the commit is blocked.
# - The hooks run in alphabetical order (glob ordering).
#
# To add a new pre-commit check:
#   1. Write scripts/git-hooks/pre-commit-<name> (executable, bash).
#   2. Re-run: bash scripts/setup-git-hooks.sh (or just relink manually).
#
# To bypass ALL pre-commit hooks (emergency only — leaves a reflog record):
#   git commit --no-verify

set -uo pipefail

HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
SRC_DIR="$(cd "$(git rev-parse --show-toplevel)/scripts/git-hooks" && pwd 2>/dev/null || echo "$HOOKS_DIR")"

# Find all pre-commit-* hooks (excluding this wrapper itself if it's in the
# same dir; the glob pre-commit-* excludes a file named exactly pre-commit).
HOOKS=$(ls "$SRC_DIR"/pre-commit-* 2>/dev/null | sort || true)

if [ -z "$HOOKS" ]; then
  # No pre-commit hooks configured — exit 0 (don't block the commit).
  exit 0
fi

FAILED=0
for hook in $HOOKS; do
  [ -x "$hook" ] || continue
  # Run the hook; if it fails, mark failed + continue (so the user sees ALL
  # failures, not just the first).
  if ! bash "$hook"; then
    FAILED=1
  fi
done

exit $FAILED
