// Prisma schema — Columbia River Gorge National Scenic Area (CRGNSA)
// Real Estate & Land Supply Analytics platform.
// A Supabase/PostgreSQL equivalent migration (with RLS policies) ships in
// /supabase/migration.sql for production deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// Expansion registry (EXPANSION-PLAN.md §2) — one row per market region.
// The corridor is the first LIVE region; the PNW/USA/Canada waves are
// seeded as scaffold/planned/research rows so market expansion stays a
// data problem (seed migrations), never a code fork.
// ---------------------------------------------------------------------
model Region {
  id                String    @id @default(uuid())
  slug              String    @unique
  name              String
  country           String // "USA" | "Canada"
  statesProvinces   String // "OR + WA" | "WA" | "BC" | …
  wave              String // "core" | "pnw" | "usa" | "canada"
  status            String // "live" | "scaffold" | "planned" | "research"
  scarcityHook      String // one-line regulatory scarcity story
  regulatoryContext String // the region's statute narrative (framework explorer source)
  taxArbitrageNote  String // the cross-border tax hook, if any
  targetSubmarkets  Int // planned micro-market count when built out
  launchOrder       Int // ordering within the rollout plan
  launchedAt        DateTime? // non-null only for live regions
  createdAt         DateTime  @default(now())
  submarkets        Submarket[]

  @@index([wave])
  @@index([status])
}

// One row per micro-market jurisdiction inside a region (first region:
// the CRGNSA corridor).
model Submarket {
  id                    String            @id @default(uuid())
  slug                  String            @unique
  name                  String
  state                 String // "OR" | "WA"
  county                String
  jurisdictionType      String // "Incorporated City" | "Unincorporated Urban Area"
  regulatoryFramework   String // "Goal 14 UGB" | "GMA UGA / Partial Planning" | "GMA UGA / Full Planning"
  totalFootprintAcres   Float
  grossVacantAcres      Float
  netBuildableAcresMin  Float
  netBuildableAcresMax  Float
  baselinePrice2026     Float // midpoint of the 2026 baseline band
  pricePerSqftMin       Float
  pricePerSqftMax       Float
  daysOnMarketMin       Int
  daysOnMarketMax       Int
  projectedCagr         Float // percent, e.g. 5.8 == 5.8%
  projectedPrice2046Min Float
  projectedPrice2046Max Float
  waterPurveyor         String
  wastewaterSystem      String
  primaryConstraints    String
  summaryNarrative      String
  depletionYear         Int // estimated year of terminal raw-land depletion
  mapX                  Float // 0-100 relative position on corridor map
  mapY                  Float // 0-100 relative position on corridor map
  regionId              String?
  region                Region?  @relation(fields: [regionId], references: [id])
  createdAt             DateTime          @default(now())
  listings              PropertyListing[]

  @@index([state])
  @@index([jurisdictionType])
  @@index([regionId])
}

// Curated property listings across the corridor.
model PropertyListing {
  id           String    @id @default(uuid())
  submarketId  String
  submarket    Submarket @relation(fields: [submarketId], references: [id], onDelete: Cascade)
  title        String
  propertyType String // "Single-Family" | "Luxury Agricultural/Farm Estate" | "Infill Multi-Family" | "Land Parcel"
  price        Float
  acreage      Float
  bedrooms     Int
  bathrooms    Float
  squareFeet   Int
  zoningCode   String
  description  String
  imageUrl     String
  featured     Boolean   @default(false)
  status       String    @default("Active") // "Active" | "Pending" | "New"
  createdAt    DateTime  @default(now())

  @@index([submarketId])
  @@index([propertyType])
}
